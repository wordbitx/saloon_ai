# ── Database (required) ──────────────────────────────────────────────────────
# Sandbox: local Postgres. Production: Supabase ka connection string
# (Supabase → Project Settings → Database → Connection string / URI)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Supabase (Phase 2 — Auth wiring ke liye) ────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (Phase 2 — abhi KHALI chhorein) ───────────────────────
# Meta Business verification + approved templates ke BAAD hi fill karein.
# Phase 1 mein inke hone par bhi live send disabled hai (guardrail).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=